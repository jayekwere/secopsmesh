FROM postgres:17-alpine@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac
# The service starts directly as postgres, so the root-only Go privilege helper is unnecessary.
RUN rm -f /usr/local/bin/gosu && mkdir -p /var/lib/postgresql/data /var/run/postgresql && chown -R 70:70 /var/lib/postgresql /var/run/postgresql
USER 70:70
